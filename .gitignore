# macOS
.DS_Store

# Agents
.claude/settings.local.json
.claude/skills/read-claude-code-session-traces/*

# Nothing reads a .env any more -- the driver takes XDG_STATE_HOME from the
# environment -- but developers upgrading from the shell path still have one,
# and it must not become committable just because it went unused.
.env

# Python. The glob covers per-platform environments beside the default .venv:
# a venv is not portable across platforms, so a macOS host and a Linux sandbox
# sharing this tree each need their own (selected by UV_PROJECT_ENVIRONMENT).
.venv*/
__pycache__/
.pytest_cache/
.ruff_cache/

# web2md HTML fetch cache. The old path stays ignored so a clone that
# predates the move to extras/ cannot commit its leftover cache by accident.
extras/web2md/cache/
web2md/cache/

# md input folder
# md/*

# okf output folder
okf/*

# lat.md (`lat init`). Anchored to the repository root: a bare `.pi` matches
# at any depth and would ignore the Pi kit's own config under
# kits/md2okf-pi/files/home/.pi/.
/.lat-build
/.pi/
# lat.md/.gitignore ignores these too, but hatchling reads only this root file
# when it builds the sdist, so without these lines lat's local search index and
# per-machine config would ship in it.
/lat.md/.cache/
/lat.md/config.local.yaml
