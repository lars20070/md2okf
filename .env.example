# md2okf host configuration.
#
# Copy this file to .env (gitignored, never committed) and uncomment or edit
# any line you want to change:
#   cp .env.example .env

# Where md2okf stores its state tree. Must be an absolute path;
# a relative value is treated as unset.
# Default: ~/.local/state
#XDG_STATE_HOME="${HOME}/.local/state"
