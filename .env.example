# Example environment for md2okf. Copy it to .env (which git ignores) and edit.
#
# Nothing loads this file automatically: md2okf reads only the environment of
# the shell that runs it. Export the variables before running md2okf, e.g.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# See docs/configuration.md for what each variable does.

# The agent that compiles: pi (the default), claude or codex.
MD2OKF_AGENT=pi

# Where session state and the workbench live. Must be an absolute path; a
# relative value counts as unset. Default: ~/.local/state
XDG_STATE_HOME=/absolute/path/to/state

# Pi's OpenRouter key. md2okf never reads it from the environment: store it
# with the two `sbx secret` commands in the README ("Set up the OpenRouter
# key"), which read it from here once it is exported.
OPENROUTER_API_KEY=sk-or-...
